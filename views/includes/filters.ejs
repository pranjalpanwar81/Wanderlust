<div class="filters-container">
  <div class="filters-wrapper">
    <div class="filter-items-scroll">
      <div class="filter-item" data-filter="all">
        <i class="fa-solid fa-house"></i>
        <span>All</span>
      </div>
      <div class="filter-item" data-filter="beach">
        <i class="fa-solid fa-umbrella-beach"></i>
        <span>Beach</span>
      </div>
      <div class="filter-item" data-filter="mountains">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
      </div>
      <div class="filter-item" data-filter="cabin">
        <i class="fa-solid fa-tree"></i>
        <span>Cabins</span>
      </div>
      <div class="filter-item" data-filter="pool">
        <i class="fa-solid fa-water-ladder"></i>
        <span>Amazing pools</span>
      </div>
      <div class="filter-item" data-filter="camping">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
      </div>
      <div class="filter-item" data-filter="farm">
        <i class="fa-solid fa-tractor"></i>
        <span>Farms</span>
      </div>
      <div class="filter-item" data-filter="arctic">
        <i class="fa-solid fa-snowflake"></i>
        <span>Arctic</span>
      </div>
      <div class="filter-item" data-filter="trending">
        <i class="fa-solid fa-fire"></i>
        <span>Trending</span>
      </div>
      <div class="filter-item" data-filter="luxury">
        <i class="fa-solid fa-gem"></i>
        <span>Luxury</span>
      </div>
    </div>
    
    <div class="filter-actions">
      <div class="tax-toggle-wrapper">
        <label class="tax-toggle-label" for="taxToggle">Show total with taxes</label>
        <label class="tax-switch">
          <input type="checkbox" id="taxToggle">
          <span class="tax-slider"></span>
        </label>
      </div>
      
      <div class="sort-dropdown">
        <button class="sort-btn" id="sortBtn">
          <i class="fa-solid fa-sort"></i>
          <span>Sort</span>
        </button>
        <div class="sort-menu" id="sortMenu">
          <div class="sort-option" data-sort="default">Default</div>
          <div class="sort-option" data-sort="price-low">Price: Low to High</div>
          <div class="sort-option" data-sort="price-high">Price: High to Low</div>
          <div class="sort-option" data-sort="newest">Newest First</div>
        </div>
      </div>
      
      <div class="price-filter">
        <button class="price-btn" id="priceBtn">
          <i class="fa-solid fa-sliders"></i>
          <span>Price</span>
        </button>
        <div class="price-menu" id="priceMenu">
          <div class="price-inputs">
            <div class="price-input-group">
              <label>Min</label>
              <input type="number" id="minPrice" placeholder="₹0" min="0">
            </div>
            <div class="price-input-group">
              <label>Max</label>
              <input type="number" id="maxPrice" placeholder="Any" min="0">
            </div>
          </div>
          <button class="apply-price-btn" id="applyPriceBtn">Apply</button>
        </div>
      </div>
    </div>
  </div>
</div>



<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterItems = document.querySelectorAll('.filter-item');
  const sortBtn = document.getElementById('sortBtn');
  const sortMenu = document.getElementById('sortMenu');
  const sortOptions = document.querySelectorAll('.sort-option');
  const priceBtn = document.getElementById('priceBtn');
  const priceMenu = document.getElementById('priceMenu');
  const applyPriceBtn = document.getElementById('applyPriceBtn');
  const minPriceInput = document.getElementById('minPrice');
  const maxPriceInput = document.getElementById('maxPrice');
  const taxToggle = document.getElementById('taxToggle');
  
  // Get current URL parameters
  const urlParams = new URLSearchParams(window.location.search);
  const currentFilter = urlParams.get('filter') || localStorage.getItem('currentFilter') || 'all';
  const currentSort = urlParams.get('sortBy') || 'default';
  const currentMinPrice = urlParams.get('minPrice') || '';
  const currentMaxPrice = urlParams.get('maxPrice') || '';
  
  // Set active filter
  filterItems.forEach(item => {
    if (item.getAttribute('data-filter') === currentFilter) {
      item.classList.add('active');
    }
  });
  
  // Set active sort option
  sortOptions.forEach(option => {
    if (option.getAttribute('data-sort') === currentSort) {
      option.classList.add('active');
    }
  });
  
  // Set price inputs
  if (currentMinPrice) minPriceInput.value = currentMinPrice;
  if (currentMaxPrice) maxPriceInput.value = currentMaxPrice;
  
  // Set tax toggle state from localStorage
  const taxEnabled = localStorage.getItem('taxEnabled') === 'true';
  taxToggle.checked = taxEnabled;
  updatePrices(taxEnabled);
  
  // Tax toggle change handler
  taxToggle.addEventListener('change', function() {
    const enabled = this.checked;
    localStorage.setItem('taxEnabled', enabled);
    updatePrices(enabled);
  });
  
  // Function to update prices based on tax toggle
  function updatePrices(withTax) {
    const priceElements = document.querySelectorAll('.listing-price');
    priceElements.forEach(element => {
      const basePrice = parseFloat(element.getAttribute('data-base-price'));
      if (!isNaN(basePrice)) {
        if (withTax) {
          const taxAmount = basePrice * 0.18;
          const totalPrice = basePrice + taxAmount;
          element.textContent = '₹' + totalPrice.toLocaleString('en-IN');
          element.setAttribute('title', 'Includes 18% GST');
        } else {
          element.textContent = '₹' + basePrice.toLocaleString('en-IN');
          element.setAttribute('title', 'Before taxes');
        }
      }
    });
  }
  
  // Filter item click handler
  filterItems.forEach(item => {
    item.addEventListener('click', function() {
      filterItems.forEach(i => i.classList.remove('active'));
      this.classList.add('active');
      
      const filter = this.getAttribute('data-filter');
      localStorage.setItem('currentFilter', filter);
      
      // Preserve current sort and price filters
      const newUrl = new URL(window.location);
      newUrl.searchParams.set('filter', filter);
      if (currentSort !== 'default') newUrl.searchParams.set('sortBy', currentSort);
      if (currentMinPrice) newUrl.searchParams.set('minPrice', currentMinPrice);
      if (currentMaxPrice) newUrl.searchParams.set('maxPrice', currentMaxPrice);
      
      window.location.href = newUrl.toString();
    });
  });
  
  // Sort dropdown toggle
  sortBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    sortMenu.classList.toggle('show');
    priceMenu.classList.remove('show');
    
    // Position the menu dynamically
    if (sortMenu.classList.contains('show')) {
      const rect = sortBtn.getBoundingClientRect();
      const menuWidth = sortMenu.offsetWidth || 200;
      const screenWidth = window.innerWidth;
      
      let leftPos = rect.left;
      
      // Adjust if menu would go off screen
      if (leftPos + menuWidth > screenWidth) {
        leftPos = screenWidth - menuWidth - 20;
      }
      
      sortMenu.style.top = (rect.bottom + 8) + 'px';
      sortMenu.style.left = leftPos + 'px';
    }
  });
  
  // Price dropdown toggle
  priceBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    priceMenu.classList.toggle('show');
    sortMenu.classList.remove('show');
    
    // Position the menu dynamically
    if (priceMenu.classList.contains('show')) {
      const rect = priceBtn.getBoundingClientRect();
      const menuWidth = priceMenu.offsetWidth || 200;
      const screenWidth = window.innerWidth;
      
      let leftPos = rect.left;
      
      // Adjust if menu would go off screen
      if (leftPos + menuWidth > screenWidth) {
        leftPos = screenWidth - menuWidth - 20;
      }
      
      priceMenu.style.top = (rect.bottom + 8) + 'px';
      priceMenu.style.left = leftPos + 'px';
    }
  });
  
  // Prevent dropdowns from closing when clicking inside them
  sortMenu.addEventListener('click', function(e) {
    e.stopPropagation();
  });
  
  priceMenu.addEventListener('click', function(e) {
    e.stopPropagation();
  });
  
  // Close dropdowns when clicking outside
  document.addEventListener('click', function() {
    sortMenu.classList.remove('show');
    priceMenu.classList.remove('show');
  });
  
  // Sort option click handler
  sortOptions.forEach(option => {
    option.addEventListener('click', function() {
      const sortBy = this.getAttribute('data-sort');
      
      sortOptions.forEach(o => o.classList.remove('active'));
      this.classList.add('active');
      
      const newUrl = new URL(window.location);
      newUrl.searchParams.set('sortBy', sortBy);
      if (currentMinPrice) newUrl.searchParams.set('minPrice', currentMinPrice);
      if (currentMaxPrice) newUrl.searchParams.set('maxPrice', currentMaxPrice);
      
      window.location.href = newUrl.toString();
    });
  });
  
  // Apply price filter
  applyPriceBtn.addEventListener('click', function() {
    const minPrice = minPriceInput.value;
    const maxPrice = maxPriceInput.value;
    
    const newUrl = new URL(window.location);
    if (minPrice) newUrl.searchParams.set('minPrice', minPrice);
    else newUrl.searchParams.delete('minPrice');
    if (maxPrice) newUrl.searchParams.set('maxPrice', maxPrice);
    else newUrl.searchParams.delete('maxPrice');
    
    window.location.href = newUrl.toString();
  });
});
</script>
