<div class="filters-container">
  <div class="filters-wrapper">
    <div class="filter-items-scroll">
      <div class="filter-item" data-filter="all">
        <i class="fa-solid fa-house"></i>
        <span>All</span>
      </div>
      <div class="filter-item" data-filter="beach">
        <i class="fa-solid fa-umbrella-beach"></i>
        <span>Beach</span>
      </div>
      <div class="filter-item" data-filter="mountains">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
      </div>
      <div class="filter-item" data-filter="cabin">
        <i class="fa-solid fa-tree"></i>
        <span>Cabins</span>
      </div>
      <div class="filter-item" data-filter="pool">
        <i class="fa-solid fa-water-ladder"></i>
        <span>Amazing pools</span>
      </div>
      <div class="filter-item" data-filter="camping">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
      </div>
      <div class="filter-item" data-filter="farm">
        <i class="fa-solid fa-tractor"></i>
        <span>Farms</span>
      </div>
      <div class="filter-item" data-filter="arctic">
        <i class="fa-solid fa-snowflake"></i>
        <span>Arctic</span>
      </div>
      <div class="filter-item" data-filter="trending">
        <i class="fa-solid fa-fire"></i>
        <span>Trending</span>
      </div>
      <div class="filter-item" data-filter="luxury">
        <i class="fa-solid fa-gem"></i>
        <span>Luxury</span>
      </div>
    </div>
    
    <div class="filter-actions">
      <div class="sort-dropdown">
        <button class="sort-btn" id="sortBtn">
          <i class="fa-solid fa-sort"></i>
          <span>Sort by</span>
        </button>
        <div class="sort-menu" id="sortMenu">
          <div class="sort-option" data-sort="default">Default</div>
          <div class="sort-option" data-sort="price-low">Price: Low to High</div>
          <div class="sort-option" data-sort="price-high">Price: High to Low</div>
          <div class="sort-option" data-sort="newest">Newest First</div>
        </div>
      </div>
      
      <div class="price-filter">
        <button class="price-btn" id="priceBtn">
          <i class="fa-solid fa-sliders"></i>
          <span>Price Range</span>
        </button>
        <div class="price-menu" id="priceMenu">
          <div class="price-inputs">
            <div class="price-input-group">
              <label>Min</label>
              <input type="number" id="minPrice" placeholder="₹0" min="0">
            </div>
            <div class="price-input-group">
              <label>Max</label>
              <input type="number" id="maxPrice" placeholder="Any" min="0">
            </div>
          </div>
          <button class="apply-price-btn" id="applyPriceBtn">Apply</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
