<script>
  // Add active class to Add Your New Home button when on that page
  document.addEventListener('DOMContentLoaded', function() {
    const addHomeBtn = document.getElementById('addHomeBtn');
    if (addHomeBtn && window.location.pathname === '/listings/new') {
      addHomeBtn.classList.add('active');
    }
  });
</script>