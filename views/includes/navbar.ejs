<nav class="navbar navbar-expand-lg wl-nav">
  <div class="wl-nav-inner">
    <a class="wl-brand" href="/" aria-label="Wanderlust home"><i class="fa-regular fa-compass"></i><span>Wanderlust</span></a>
    <button class="navbar-toggler wl-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#wlNav" aria-controls="wlNav" aria-expanded="false" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>
    <div class="collapse navbar-collapse" id="wlNav">
      <form class="wl-search" action="/listings/search" method="GET" role="search">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <label class="visually-hidden" for="navSearch">Search stays</label>
        <input id="navSearch" type="text" name="q" placeholder="Search by place or title" value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>">
        <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
      </form>
      <div class="wl-links">
        <a class="wl-link" href="/listings">Explore stays</a>
        <a class="wl-link" id="addHomeBtn" href="/listings/new">List your home</a>
        <label class="wl-theme" title="Dark mode">
          <input type="checkbox" id="darkModeToggle" aria-label="Dark mode">
          <span class="wl-theme-track"><i class="fa-solid fa-sun"></i><i class="fa-solid fa-moon"></i></span>
        </label>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <span class="wl-user"><i class="fa-regular fa-circle-user"></i><%= currentUser.username %></span>
          <a class="wl-link" href="/logout">Log out</a>
        <% } else { %>
          <a class="wl-link" href="/login">Log in</a>
          <a class="wl-pill" href="/signup">Sign up</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var addHomeBtn = document.getElementById('addHomeBtn');
    if (addHomeBtn && window.location.pathname === '/listings/new') addHomeBtn.classList.add('active');

    var toggle = document.getElementById('darkModeToggle');
    toggle.checked = document.body.classList.contains('dark-mode');
    toggle.addEventListener('change', function () {
      document.body.classList.toggle('dark-mode', this.checked);
      try { localStorage.setItem('darkModeEnabled', this.checked ? 'true' : 'false'); } catch (e) {}
    });
  });
</script>
