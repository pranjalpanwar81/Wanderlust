<% if (typeof success !== 'undefined' && success && success.length) { %>
	<div class="wl-flash success alert alert-dismissible fade show" role="status">
		<i class="fa-solid fa-circle-check"></i><span><%= success %></span>
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
	</div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length) { %>
	<div class="wl-flash error alert alert-dismissible fade show" role="alert">
		<i class="fa-solid fa-circle-exclamation"></i><span><%= error %></span>
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
	</div>
<% } %>
