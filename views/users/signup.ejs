<% layout("layouts/boilerplate") %>

<div class="row mt-5">
    <div class="col-6 offset-3">
        <div class="signup-form-container">
            <h1 class="text-center">Sign Up</h1>
            <p class="text-center text-muted mb-4">Create your Wanderlust account</p>
            <form action="/users/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" class="form-control" id="username" name="username" placeholder="Choose a username" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Create a password" required>
                </div>
                <button type="submit" class="btn btn-dark w-100 signup-btn">Sign Up</button>
            </form>
            <div class="text-center mt-3">
                <p class="mb-0">Already have an account? <a href="/login">Login</a></p>
            </div>
        </div>
    </div>
</div>

<style>
.signup-form-container {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.signup-form-container h1 {
    font-weight: 700;
    color: #333;
}

.signup-form-container .form-control {
    border-radius: 8px;
    padding: 12px 16px;
    border: 1px solid #e0e0e0;
    transition: all 0.3s ease;
}

.signup-form-container .form-control:focus {
    border-color: #ff5722;
    box-shadow: 0 0 0 3px rgba(255, 87, 34, 0.1);
}

.signup-btn {
    background-color: #ff5722 !important;
    border: none;
    padding: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.signup-btn:hover {
    background-color: #e64a19 !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(255, 87, 34, 0.3);
}

.signup-form-container a {
    color: #ff5722;
    text-decoration: none;
    font-weight: 500;
}

.signup-form-container a:hover {
    text-decoration: underline;
}
</style>