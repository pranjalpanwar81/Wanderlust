<% layout("/layouts/boilerplate") %>

<section class="wl-page wl-narrow">
  <header class="wl-page-head">
    <h1>List your home</h1>
    <p>Tell travellers what makes your place worth the trip.</p>
  </header>

  <form method="POST" action="/listings" novalidate class="needs-validation wl-card wl-form" enctype="multipart/form-data">
    <div class="wl-field">
      <label for="title" class="form-label">Title</label>
      <input id="title" name="listing[title]" placeholder="Sunny cottage by the sea" type="text" class="form-control" required>
      <div class="invalid-feedback">Give your place a title.</div>
    </div>

    <div class="wl-field">
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="listing[description]" rows="5" placeholder="What's the space like? What's nearby?" class="form-control" required></textarea>
      <div class="invalid-feedback">Add a short description.</div>
    </div>

        <div class="wl-field">
          <label for="image" class="form-label">Photo</label>
          <input id="image" name="listing[image]" type="file" class="form-control" accept="image/*" required>
          <p class="wl-hint">A wide, bright photo works best. JPG or PNG.</p>
          <div class="invalid-feedback">Add a photo of the place.</div>
        </div>

    <div class="wl-field-row">
      <div class="wl-field">
        <label for="price" class="form-label">Price per night (&#8377;)</label>
        <input id="price" name="listing[price]" placeholder="2500" type="number" min="0" class="form-control" required>
        <div class="invalid-feedback">Enter a nightly price.</div>
      </div>
      <div class="wl-field">
        <label for="category" class="form-label">Kind of stay</label>
        <select id="category" name="listing[category]" class="form-select" required>
          <option value="">Choose one</option>
            <option value="beach">Beach</option>
            <option value="mountains">Mountains</option>
            <option value="cabin">Cabins</option>
            <option value="pool">Amazing pools</option>
            <option value="camping">Camping</option>
            <option value="farm">Farms</option>
            <option value="arctic">Arctic</option>
            <option value="trending">Trending</option>
            <option value="luxury">Luxury</option>
        </select>
        <div class="invalid-feedback">Pick the kind of stay.</div>
      </div>
    </div>

    <div class="wl-field-row">
      <div class="wl-field">
        <label for="location" class="form-label">Town or city</label>
        <input id="location" name="listing[location]" placeholder="Manali" type="text" class="form-control" required>
        <div class="invalid-feedback">Enter where the place is.</div>
      </div>
      <div class="wl-field">
        <label for="country" class="form-label">Country</label>
        <input id="country" name="listing[country]" placeholder="India" type="text" class="form-control" required>
        <div class="invalid-feedback">Enter the country.</div>
      </div>
    </div>

    <div class="wl-actions">
      <button class="wl-btn primary">Publish listing</button>
      <a class="wl-btn ghost" href="/listings">Cancel</a>
    </div>
  </form>
</section>
