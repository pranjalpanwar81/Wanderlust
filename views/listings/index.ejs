<% layout("layouts/boilerplate") %>
<%- include("../includes/filters.ejs") %>

<section class="wl-page">
  <% if (searchQuery) { %>
    <header class="wl-page-head">
      <h1>Stays matching "<%= searchQuery %>"</h1>
      <p><%= allListings.length %> <%= allListings.length === 1 ? 'stay' : 'stays' %> found. <a href="/listings">Clear search</a></p>
    </header>
  <% } %>

  <% if (allListings.length) { %>
    <div class="wl-grid">
      <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="wl-stay">
          <div class="wl-stay-img">
            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=900&q=70' %>" alt="<%= listing.title %>" loading="lazy">
          </div>
          <h2 class="wl-stay-title"><%= listing.title %></h2>
          <p class="wl-stay-where"><%= [listing.location, listing.country].filter(Boolean).join(', ') %></p>
          <p class="wl-stay-price"><span class="listing-price" data-base-price="<%= listing.price || 0 %>">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> a night</p>
        </a>
      <% } %>
    </div>
  <% } else { %>
    <div class="wl-empty">
      <i class="fa-solid fa-map-location-dot wl-empty-icon"></i>
      <h1>No stays match yet</h1>
      <p>Try another place or clear the filters to see every stay.</p>
      <div class="wl-actions"><a class="wl-btn primary" href="/listings">Show all stays</a></div>
    </div>
  <% } %>
</section>
