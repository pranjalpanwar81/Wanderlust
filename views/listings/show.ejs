<% layout("layouts/boilerplate") %>
<input type="hidden" id="mapToken" value="<%= process.env.MAP_TOKEN %>">
<input type="hidden" id="listingCoordinates" value="<%= (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates.join(',') : '77.2090,28.6139' %>">
<input type="hidden" id="listingLocation" value="<%= listing.location %>, <%= listing.country %>">
<input type="hidden" id="currentListingId" value="<%= listing._id %>">
<% if (listing.geometry && listing.geometry.coordinates) { %>
<input type="hidden" id="debugCoords" value="<%= listing.geometry.coordinates %>">
<% } %> 
<% const img = listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1400&q=70'; %>
<% const isOwner = currentUser && listing.owner && listing.owner._id && currentUser._id.toString() === listing.owner._id.toString(); %>
<% const maxSlots = listing.maxSlots || 10; const taken = listing.bookings ? listing.bookings.filter(b => b.status === 'confirmed').length : 0; %>
<% const avg = listing.reviews.length ? (listing.reviews.reduce((t, r) => t + (r.rating || 0), 0) / listing.reviews.length) : 0; %>

<article class="wl-page wl-show">
  <a class="wl-back" href="/listings"><i class="fa-solid fa-arrow-left"></i>All stays</a>

  <header class="wl-show-head">
    <h1><%= listing.title %></h1>
    <p class="wl-show-meta">
      <span><i class="fa-solid fa-location-dot"></i><%= [listing.location, listing.country].filter(Boolean).join(', ') %></span>
      <% if (listing.reviews.length) { %><span><i class="fa-solid fa-star"></i><%= avg.toFixed(1) %> from <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %></span><% } %>
      <% if (listing.category) { %><span class="wl-tag"><%= listing.category %></span><% } %>
    </p>
  </header>

  <div class="wl-show-photo"><img src="<%= img %>" alt="<%= listing.title %>"></div>

  <div class="wl-show-grid">
    <div class="wl-show-main">
      <div class="wl-host">
        <span class="wl-avatar"><%= (listing.owner && listing.owner.username ? listing.owner.username : '?').charAt(0).toUpperCase() %></span>
        <div>
          <p class="wl-host-name">Hosted by <%= listing.owner && listing.owner.username ? listing.owner.username : "Unknown" %></p>
          <p class="wl-muted">Your host for this stay</p>
        </div>
      </div>

      <h2 class="wl-h2">About this place</h2>
      <p class="wl-desc"><%= listing.description %></p>

      <% if (isOwner) { %>
        <div class="wl-owner">
          <p class="wl-muted">This is your listing.</p>
          <div class="wl-actions">
            <a href="/listings/<%= listing._id %>/edit" class="wl-btn ghost"><i class="fa-regular fa-pen-to-square"></i>Edit listing</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing? This can\'t be undone.');">
              <button class="wl-btn danger"><i class="fa-regular fa-trash-can"></i>Delete listing</button>
            </form>
          </div>
        </div>
      <% } %>

      <% if (listing.bookings && listing.bookings.some(b => b.status !== 'cancelled')) { %>
      <section class="wl-section">
        <h2 class="wl-h2">Current bookings</h2>
        <div id="bookingsList" class="wl-bookings">
          <% listing.bookings.forEach(function(booking) { %>
            <% if (booking.status !== 'cancelled') { %>
              <div class="wl-booking">
                <span class="wl-avatar sm"><%= (booking.user && booking.user.username ? booking.user.username : '?').charAt(0).toUpperCase() %></span>
                <div>
                  <p class="wl-booking-who"><%= booking.user && booking.user.username ? booking.user.username : 'Guest' %></p>
                  <p class="wl-muted"><%= new Date(booking.startDate).toLocaleDateString('en-GB') %> <%= new Date(booking.startDate).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'}) %> to <%= new Date(booking.endDate).toLocaleDateString('en-GB') %> <%= new Date(booking.endDate).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'}) %></p>
                </div>
                <span class="wl-status"><%= booking.status %></span>
              </div>
            <% } %>
          <% }); %>
        </div>
      </section>
      <% } %>
    </div>

    <aside class="wl-book">
      <p class="wl-book-price"><span class="show-chip listing-price" data-base-price="<%= listing.price || 0 %>">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %></span> <span class="wl-muted">a night</span></p>
      <p class="wl-slots"><span id="availableSlots"><%= maxSlots - taken %></span><span>/ <%= maxSlots %></span> slots open <span id="slotStatus"></span></p>

      <% if (currentUser) { %>
        <div id="bookingFormContainer">
          <form action="/listings/<%= listing._id %>/book" method="POST" class="booking-form">
            <div class="wl-book-fields">
              <label>Check-in date<input type="date" class="form-control" id="startDate" name="startDate" required></label>
              <label>Time<input type="time" class="form-control" id="startTime" name="startTime" required></label>
              <label>Check-out date<input type="date" class="form-control" id="endDate" name="endDate" required></label>
              <label>Time<input type="time" class="form-control" id="endTime" name="endTime" required></label>
            </div>
            <button type="submit" class="wl-btn primary block">Book this stay</button>
          </form>
        </div>
        <div id="noSlotsMessage" class="wl-note warn" style="display: none;">
          <strong>Fully booked</strong>
          <p>Every slot for this stay is taken. Check back later.</p>
        </div>
        <div id="bookingStatus"></div>
      <% } else { %>
        <a class="wl-btn primary block" href="/login">Log in to book</a>
        <p class="wl-muted small">You need an account to book. <a href="/signup">Sign up</a> takes a minute.</p>
      <% } %>
    </aside>
  </div>

  <section class="wl-section wl-reviews">
    <div class="wl-section-head">
      <h2 class="wl-h2"><%= listing.reviews.length ? 'Reviews (' + listing.reviews.length + ')' : 'Reviews' %></h2>
    </div>

    <% if (listing.reviews.length > 0) { %>
      <div class="wl-review-grid">
        <% for (review of listing.reviews) { %>
          <div class="wl-review">
            <div class="wl-review-top">
              <span class="wl-avatar sm"><%= (review.author && review.author.username ? review.author.username : 'A').charAt(0).toUpperCase() %></span>
              <p class="wl-review-who"><%= review.author && review.author.username ? review.author.username : "Anonymous" %></p>
              <p class="starability-result" data-rating="<%= review.rating %>">Rated <%= review.rating %> stars</p>
            </div>
            <p class="wl-review-text"><%= review.comment %></p>
            <% if (currentUser && review.author && review.author._id && currentUser._id.toString() === review.author._id.toString()) { %>
              <div class="wl-actions sm">
                <a class="wl-btn ghost sm" href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="wl-btn ghost sm">Delete</button>
                </form>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="wl-muted">No reviews yet. Stayed here? Be the first to share how it went.</p>
    <% } %>

    <% if (currentUser) { %>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation wl-card wl-review-form">
        <h3 class="wl-h3">Leave a review</h3>
        <fieldset class="starability-growRotate">
          <legend>Your rating</legend>
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
        <label for="comment" class="form-label">Your review</label>
        <textarea id="comment" name="review[comment]" rows="4" class="form-control" placeholder="What was the stay like?" required></textarea>
        <div class="invalid-feedback">Write a few words about your stay.</div>
        <button type="submit" class="wl-btn primary">Post review</button>
      </form>
    <% } else { %>
      <p class="wl-muted"><a href="/login">Log in</a> to leave a review.</p>
    <% } %>
  </section>

  <section class="wl-section">
    <h2 class="wl-h2">Where you'll be</h2>
    <p class="wl-muted"><%= [listing.location, listing.country].filter(Boolean).join(', ') %></p>
    <div id="map" class="wl-map"></div>
  </section>
</article>
<script src="/js/map.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  // Socket.IO for real-time booking updates (not available on serverless hosts like Netlify)
  const socket = (typeof io === 'function')
    ? io()
    : { on: function () {} };
  const currentListingId = document.getElementById('currentListingId').value;
  
  // Listen for booking creation events
  socket.on('bookingCreated', (data) => {
    if (data.listingId === currentListingId) {
      // Update the bookings list display
      updateBookingsDisplay(data.booking);
      
      // Update slot availability
      updateSlotAvailability(data.availableSlots, data.maxSlots);
      
      // Show notification
      showNotification('New booking created for this listing!');
    }
  });
  
  // Listen for booking cancellation events
  socket.on('bookingCancelled', (data) => {
    if (data.listingId === currentListingId) {
      // Remove the cancelled booking from display
      removeBookingFromDisplay(data.bookingId);
      
      // Update slot availability
      updateSlotAvailability(data.availableSlots, data.maxSlots);
      
      // Show notification
      showNotification('A booking has been cancelled for this listing.');
    }
  });
  
  function updateSlotAvailability(availableSlots, maxSlots) {
    const availableSlotsElement = document.getElementById('availableSlots');
    const slotStatusElement = document.getElementById('slotStatus');
    const bookingFormContainer = document.getElementById('bookingFormContainer');
    const noSlotsMessage = document.getElementById('noSlotsMessage');
    
    if (availableSlotsElement) {
      availableSlotsElement.textContent = availableSlots;
    }
    
    if (slotStatusElement) {
      if (availableSlots === 0) {
        slotStatusElement.textContent = 'Fully booked';
        slotStatusElement.style.color = '#c0392b';
        slotStatusElement.style.fontWeight = '600';
      } else if (availableSlots <= 3) {
        slotStatusElement.textContent = 'Filling up';
        slotStatusElement.style.color = '#c2410c';
        slotStatusElement.style.fontWeight = '600';
      } else {
        slotStatusElement.textContent = '';
      }
    }
    
    // Handle no slots state
    if (availableSlots === 0) {
      if (bookingFormContainer) {
        bookingFormContainer.style.display = 'none';
      }
      if (noSlotsMessage) {
        noSlotsMessage.style.display = 'block';
      }
    } else {
      if (bookingFormContainer) {
        bookingFormContainer.style.display = 'block';
      }
      if (noSlotsMessage) {
        noSlotsMessage.style.display = 'none';
      }
    }
  }
  
  // Initialize slot availability on page load
  const initialAvailableSlots = document.getElementById('availableSlots');
  const initialMaxSlots = document.getElementById('availableSlots')?.nextElementSibling?.textContent?.replace('/ ', '') || 10;
  if (initialAvailableSlots) {
    updateSlotAvailability(parseInt(initialAvailableSlots.textContent), parseInt(initialMaxSlots));
  }
  
  function updateBookingsDisplay(booking) {
    const bookingsList = document.getElementById('bookingsList');
    if (!bookingsList) return;
    
    const bookingItem = document.createElement('div');
    bookingItem.className = 'wl-booking';
    const fmt = d => new Date(d).toLocaleDateString('en-GB') + ' ' + new Date(d).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'});
    bookingItem.innerHTML = `
      <span class="wl-avatar sm">+</span>
      <div>
        <p class="wl-booking-who">New booking</p>
        <p class="wl-muted">${fmt(booking.startDate)} to ${fmt(booking.endDate)}</p>
      </div>
      <span class="wl-status">${booking.status}</span>
    `;
    
    bookingsList.appendChild(bookingItem);
  }
  
  function removeBookingFromDisplay(bookingId) {
    // This would need more specific implementation to identify and remove specific bookings
    // For now, we'll reload the page to get fresh data
    setTimeout(() => {
      location.reload();
    }, 1000);
  }
  
  function showNotification(message) {
    const bookingStatus = document.getElementById('bookingStatus');
    if (bookingStatus) {
      bookingStatus.innerHTML = `<div class="wl-note">${message}</div>`;
      setTimeout(() => {
        bookingStatus.innerHTML = '';
      }, 3000);
    }
  }
</script>

