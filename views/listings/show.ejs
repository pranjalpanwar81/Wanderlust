<% layout("layouts/boilerplate") %>
<input type="hidden" id="mapToken" value="<%= process.env.MAP_TOKEN %>">
<input type="hidden" id="listingCoordinates" value="<%= (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates.join(',') : '77.2090,28.6139' %>">
<input type="hidden" id="listingLocation" value="<%= listing.location %>, <%= listing.country %>">
<input type="hidden" id="currentListingId" value="<%= listing._id %>">
<% if (listing.geometry && listing.geometry.coordinates) { %>
<input type="hidden" id="debugCoords" value="<%= listing.geometry.coordinates %>">
<% } %> 
<div class="row">
  <div class="col-8 offset-3">
    <br><br>
    <div class="show-hero">
      <span class="show-kicker">Listing details</span>
      <h3><%= listing.title %></h3>
      <p class="text-muted mb-0">Explore the details, read the reviews, and decide if this stay is the right fit.</p>
    </div>
    <br>
  </div>

    <div class="card col-6 offset-3 show-card listing-card show-listing-panel">
      <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTJ8fGdvYXxlbnwwfHwwfHx8MA%3D%3D&auto=format&fit=crop&w=800&q=60' %>" class="card-img-top show-img" alt="listing_image"/> <br>
  <div class="card-body show-listing-body">
    <div class="show-detail-row">
      <span class="show-detail-label">Owned by</span>
      <span class="show-detail-value"><%= listing.owner && listing.owner.username ? listing.owner.username : "Unknown" %></span>
    </div>
    <p class="card-text show-description"><%= listing.description %></p>
    <div class="show-chip-row">
      <span class="show-chip listing-price" data-base-price="<%= listing.price || 0 %>">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
      <span class="show-chip"><%= listing.location %></span>
      <span class="show-chip"><%= listing.country %></span>
    </div>
    
    <!-- Booking Section -->
    <% if (currentUser) { %>
    <div class="booking-section mt-4 p-4 border rounded" style="background-color: #f8f9fa; border-left: 4px solid #ff5722;">
      <h5 class="mb-3" style="color: #333; font-weight: 600;">📅 Book This Listing</h5>
      
      <!-- Slot Availability Display -->
      <div class="slot-availability mb-3 p-2 rounded" style="background-color: #e9ecef; border-left: 3px solid #28a745;">
        <span style="font-weight: 600; color: #333;">Available Slots:</span>
        <span id="availableSlots" style="font-weight: 700; color: #28a745; font-size: 18px;"><%= (listing.maxSlots || 10) - (listing.bookings ? listing.bookings.filter(b => b.status === 'confirmed').length : 0) %></span>
        <span style="color: #666;">/ <%= listing.maxSlots || 10 %></span>
        <span id="slotStatus" class="ml-2" style="font-size: 14px;"></span>
      </div>
      
      <div id="bookingFormContainer">
        <form action="/listings/<%= listing._id %>/book" method="POST" class="booking-form">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="startDate" class="form-label" style="font-weight: 500;">Check-in Date</label>
              <input type="date" class="form-control" id="startDate" name="startDate" required style="padding: 10px;">
            </div>
            <div class="col-md-6 mb-3">
              <label for="startTime" class="form-label" style="font-weight: 500;">Check-in Time</label>
              <input type="time" class="form-control" id="startTime" name="startTime" required style="padding: 10px;">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="endDate" class="form-label" style="font-weight: 500;">Check-out Date</label>
              <input type="date" class="form-control" id="endDate" name="endDate" required style="padding: 10px;">
            </div>
            <div class="col-md-6 mb-3">
              <label for="endTime" class="form-label" style="font-weight: 500;">Check-out Time</label>
              <input type="time" class="form-control" id="endTime" name="endTime" required style="padding: 10px;">
            </div>
          </div>
          <button type="submit" class="btn btn-primary mt-2" style="background-color: #ff5722; border-color: #ff5722; padding: 10px 30px; font-weight: 600;">Book Now</button>
        </form>
      </div>
      
      <div id="noSlotsMessage" class="mt-3 p-3 rounded" style="background-color: #f8d7da; border: 1px solid #f5c6cb; display: none;">
        <h6 style="color: #721c24; font-weight: 600;">🚫 No Slots Available</h6>
        <p style="color: #721c24; margin: 0;">This destination is currently fully booked. Please check back later.</p>
      </div>
      
      <div id="bookingStatus" class="mt-2"></div>
    </div>
    <% } else { %>
    <div class="booking-section mt-4 p-4 border rounded" style="background-color: #f8f9fa; border-left: 4px solid #ff5722;">
      <h5 class="mb-2" style="color: #333; font-weight: 600;">📅 Book This Listing</h5>
      <p class="text-muted mb-0">Please <a href="/login" style="color: #ff5722; font-weight: 600;">log in</a> to book this listing.</p>
    </div>
    <% } %>
    
    <!-- Current Bookings Display -->
    <% if (listing.bookings && listing.bookings.length > 0) { %>
    <div class="current-bookings mt-4 p-4 border rounded" style="background-color: #f8f9fa; border-left: 4px solid #28a745;">
      <h5 class="mb-3" style="color: #333; font-weight: 600;">📋 Current Bookings</h5>
      <div id="bookingsList">
        <% listing.bookings.forEach(function(booking) { %>
          <% if (booking.status !== 'cancelled') { %>
            <div class="booking-item p-3 mb-2 border rounded" style="background-color: white; border-left: 3px solid #28a745;">
              <div style="font-size: 14px;">
                <div style="margin-bottom: 5px;">
                  <strong style="color: #333;">👤 User:</strong> 
                  <span style="color: #666;"><%= booking.user && booking.user.username ? booking.user.username : 'Unknown' %></span>
                </div>
                <div style="margin-bottom: 5px;">
                  <strong style="color: #333;">📅 Dates:</strong> 
                  <span style="color: #666;"><%= new Date(booking.startDate).toLocaleDateString('en-GB') %> <%= new Date(booking.startDate).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'}) %> - <%= new Date(booking.endDate).toLocaleDateString('en-GB') %> <%= new Date(booking.endDate).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'}) %></span>
                </div>
                <div>
                  <strong style="color: #333;">✅ Status:</strong> 
                  <span style="color: #28a745; font-weight: 600;"><%= booking.status %></span>
                </div>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
  </div>

    <br />

  <% if (currentUser && listing.owner && listing.owner._id && currentUser._id.toString() === listing.owner._id.toString()) { %>
    <div class="btns mb-5">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
      
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark offset-5 ">Delete</button>
      </form>
    </div>
  <% } %>
  <div class="col-8 offset-3 mb-5 review-section-shell">
    <hr> 
    <div class="review-section-head">
      <h4>Leave a Review</h4>
      <p class="text-muted mb-0">Share your experience so other travelers can decide faster.</p>
    </div>
    <% if (currentUser) { %>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation review-form-card" >
<fieldset class="starability-growRotate">
<legend>Rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea id="comment" name="review[comment]" rows="5"  cols="30" class = "form-control"  required></textarea>
          <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        <button type="submit" class="btn btn-dark mt-3">Submit Review</button>
      </form>
    <% } else { %>
      <div class="guest-review-card">
        <p class="text-muted mb-0">Please log in to leave a review.</p>
      </div>
    <% } %>

    <hr />

    <div class="review-section-head">
      <p class="mb-0"><b>All Reviews (<%= listing.reviews.length %>)</b></p>
      <span class="review-section-note">Visible to everyone</span>
    </div>

    <div class="row">
    <% if (listing.reviews.length > 0) { %>
      <% for(review of listing.reviews) { %>
        <div class="col-6 mb-3">
          <div class="review-card">
            <div class="review-meta">
              <h5 class="review-author">
                <%= review.author && review.author.username ? review.author.username : "Anonymous" %>
              </h5>
               <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
            </div>
            <p class="review-comment mb-0">
              <%= review.comment %>
            </p>
            <% if (currentUser && review.author && review.author._id && currentUser._id.toString() === review.author._id.toString()) { %>
              <div class="review-actions mb-0 d-flex gap-2">
                <a class="btn btn-dark" href="/listings/<%=listing._id%>/reviews/<%=review._id%>/edit">Edit</a>
                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                  <button class="btn btn-dark">Delete</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="col-12">
        <div class="guest-review-card">
          <p class="text-muted mb-0">No reviews yet. Be the first to review this listing.</p>
        </div>
      </div>
    <% } %>
</div>
  </div>
  <div class="col-8 offset-3 mb-3">
  <h3>Where you'll be</h3>
  <div id="map" style="height: 400px; width: 100%;"></div>
</div>
  </div>
<script src="/js/map.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  // Socket.IO for real-time booking updates
  const socket = io();
  const currentListingId = document.getElementById('currentListingId').value;
  
  // Listen for booking creation events
  socket.on('bookingCreated', (data) => {
    if (data.listingId === currentListingId) {
      // Update the bookings list display
      updateBookingsDisplay(data.booking);
      
      // Update slot availability
      updateSlotAvailability(data.availableSlots, data.maxSlots);
      
      // Show notification
      showNotification('New booking created for this listing!');
    }
  });
  
  // Listen for booking cancellation events
  socket.on('bookingCancelled', (data) => {
    if (data.listingId === currentListingId) {
      // Remove the cancelled booking from display
      removeBookingFromDisplay(data.bookingId);
      
      // Update slot availability
      updateSlotAvailability(data.availableSlots, data.maxSlots);
      
      // Show notification
      showNotification('A booking has been cancelled for this listing.');
    }
  });
  
  function updateSlotAvailability(availableSlots, maxSlots) {
    const availableSlotsElement = document.getElementById('availableSlots');
    const slotStatusElement = document.getElementById('slotStatus');
    const bookingFormContainer = document.getElementById('bookingFormContainer');
    const noSlotsMessage = document.getElementById('noSlotsMessage');
    
    if (availableSlotsElement) {
      availableSlotsElement.textContent = availableSlots;
    }
    
    if (slotStatusElement) {
      if (availableSlots === 0) {
        slotStatusElement.textContent = '(Fully Booked)';
        slotStatusElement.style.color = '#dc3545';
        slotStatusElement.style.fontWeight = '600';
      } else if (availableSlots <= 3) {
        slotStatusElement.textContent = '(Limited Availability)';
        slotStatusElement.style.color = '#ffc107';
        slotStatusElement.style.fontWeight = '600';
      } else {
        slotStatusElement.textContent = '';
      }
    }
    
    // Handle no slots state
    if (availableSlots === 0) {
      if (bookingFormContainer) {
        bookingFormContainer.style.display = 'none';
      }
      if (noSlotsMessage) {
        noSlotsMessage.style.display = 'block';
      }
    } else {
      if (bookingFormContainer) {
        bookingFormContainer.style.display = 'block';
      }
      if (noSlotsMessage) {
        noSlotsMessage.style.display = 'none';
      }
    }
  }
  
  // Initialize slot availability on page load
  const initialAvailableSlots = document.getElementById('availableSlots');
  const initialMaxSlots = document.getElementById('availableSlots')?.nextElementSibling?.textContent?.replace('/ ', '') || 10;
  if (initialAvailableSlots) {
    updateSlotAvailability(parseInt(initialAvailableSlots.textContent), parseInt(initialMaxSlots));
  }
  
  function updateBookingsDisplay(booking) {
    const bookingsList = document.getElementById('bookingsList');
    if (!bookingsList) return;
    
    const bookingItem = document.createElement('div');
    bookingItem.className = 'booking-item p-3 mb-2 border rounded';
    bookingItem.style = 'background-color: white; border-left: 3px solid #28a745;';
    bookingItem.innerHTML = `
      <div style="font-size: 14px;">
        <div style="margin-bottom: 5px;">
          <strong style="color: #333;">👤 User:</strong> 
          <span style="color: #666;">Current User</span>
        </div>
        <div style="margin-bottom: 5px;">
          <strong style="color: #333;">📅 Dates:</strong> 
          <span style="color: #666;">${new Date(booking.startDate).toLocaleDateString('en-GB')} ${new Date(booking.startDate).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'})} - ${new Date(booking.endDate).toLocaleDateString('en-GB')} ${new Date(booking.endDate).toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'})}</span>
        </div>
        <div>
          <strong style="color: #333;">✅ Status:</strong> 
          <span style="color: #28a745; font-weight: 600;">${booking.status}</span>
        </div>
      </div>
    `;
    
    bookingsList.appendChild(bookingItem);
  }
  
  function removeBookingFromDisplay(bookingId) {
    // This would need more specific implementation to identify and remove specific bookings
    // For now, we'll reload the page to get fresh data
    setTimeout(() => {
      location.reload();
    }, 1000);
  }
  
  function showNotification(message) {
    const bookingStatus = document.getElementById('bookingStatus');
    if (bookingStatus) {
      bookingStatus.innerHTML = `<div class="alert alert-info">${message}</div>`;
      setTimeout(() => {
        bookingStatus.innerHTML = '';
      }, 3000);
    }
  }
</script>
  </body>
</html>
