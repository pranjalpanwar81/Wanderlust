<% layout("layouts/boilerplate") %>

<section class="wl-page wl-narrow">
  <header class="wl-page-head">
    <h1>Edit your review</h1>
    <p>For <a href="/listings/<%= listing._id %>"><%= listing.title %></a></p>
  </header>
  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT" novalidate class="needs-validation wl-card wl-form">
    <fieldset class="starability-growRotate">
      <legend>Your rating</legend>
      <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" aria-label="No rating." <%= review.rating ? "" : "checked" %> />
      <% for (let i = 1; i <= 5; i++) { %>
        <input type="radio" id="first-rate<%= i %>" name="review[rating]" value="<%= i %>" <%= review.rating === i ? "checked" : "" %> />
        <label for="first-rate<%= i %>"><%= i %> star<%= i > 1 ? "s" : "" %></label>
      <% } %>
    </fieldset>
    <div class="wl-field">
      <label for="comment" class="form-label">Your review</label>
      <textarea id="comment" name="review[comment]" rows="5" class="form-control" required><%= review.comment %></textarea>
      <div class="invalid-feedback">Write a few words about your stay.</div>
    </div>
    <div class="wl-actions">
      <button type="submit" class="wl-btn primary">Save review</button>
      <a class="wl-btn ghost" href="/listings/<%= listing._id %>">Cancel</a>
    </div>
  </form>
</section>
